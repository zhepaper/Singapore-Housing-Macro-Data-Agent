{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/evidence.schema.json",
  "title": "Validated report evidence",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "metric_id", "source_id", "run_id", "provenance_id", "series_label", "market", "period", "value", "unit",
    "factor", "mechanism", "limitations", "source_url", "source_page_url",
    "raw_snapshot_path", "raw_sha256", "retrieved_at", "completeness"
  ],
  "properties": {
    "metric_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "provenance_id": {"type": "string", "minLength": 3},
    "series_label": {"type": "string", "minLength": 1},
    "market": {"enum": ["sale", "rent", "shared"]},
    "period": {"type": "string", "minLength": 4},
    "value": {"type": "number"},
    "unit": {"type": "string", "minLength": 1},
    "factor": {"type": "string", "minLength": 1},
    "mechanism": {"type": "string", "minLength": 1},
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "source_url": {"type": "string", "format": "uri"},
    "source_page_url": {"type": "string", "format": "uri"},
    "raw_snapshot_path": {"type": "string", "minLength": 1},
    "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "completeness": {"enum": ["complete", "incomplete", "provisional", "stale", "unavailable"]}
  }
}
